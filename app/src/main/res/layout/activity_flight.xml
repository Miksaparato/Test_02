<?xml version="1.0" encoding="utf-8"?>
<!--
     实验四：约束布局（ConstraintLayout）综合练习 —— 航班预订界面
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- 顶部标签栏 -->
    <ImageView
        android:id="@+id/iconStations"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:contentDescription="Space Stations"
        android:src="@drawable/space_station_icon"
        app:layout_constraintEnd_toStartOf="@id/iconFlights"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iconFlights"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:contentDescription="Flights"
        android:src="@drawable/rocket_icon"
        app:layout_constraintEnd_toStartOf="@id/iconRovers"
        app:layout_constraintStart_toEndOf="@id/iconStations"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iconRovers"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="32dp"
        android:contentDescription="Rovers"
        android:src="@drawable/rover_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iconFlights"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 每个图标下面的文字 -->
    <TextView
        android:id="@+id/labelStations"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#E0E0E0"
        android:gravity="center"
        android:text="Space Stations"
        android:textColor="#444444"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/iconStations"
        app:layout_constraintStart_toStartOf="@id/iconStations"
        app:layout_constraintTop_toBottomOf="@id/iconStations" />

    <TextView
        android:id="@+id/labelFlights"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#E0E0E0"
        android:gravity="center"
        android:text="Flights"
        android:textColor="#444444"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/iconFlights"
        app:layout_constraintStart_toStartOf="@id/iconFlights"
        app:layout_constraintTop_toBottomOf="@id/iconFlights" />

    <TextView
        android:id="@+id/labelRovers"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#E0E0E0"
        android:gravity="center"
        android:text="Rovers"
        android:textColor="#444444"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/iconRovers"
        app:layout_constraintStart_toStartOf="@id/iconRovers"
        app:layout_constraintTop_toBottomOf="@id/iconRovers" />

    <!-- DCA 绿色框 -->
    <TextView
        android:id="@+id/boxDca"
        android:layout_width="164dp"
        android:layout_height="75dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="32dp"
        android:background="#2E7D32"
        android:gravity="center"
        android:text="DCA"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:layout_constraintEnd_toStartOf="@id/imgArrows"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/labelStations" />

    <!-- MARS 绿色框 -->
    <TextView
        android:id="@+id/boxMars"
        android:layout_width="163dp"
        android:layout_height="68dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="48dp"
        android:background="#2E7D32"
        android:gravity="center"
        android:text="MARS"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imgArrows"
        app:layout_constraintTop_toBottomOf="@id/labelStations" />

    <!-- 中间的双向箭头图片 -->
    <ImageView
        android:id="@+id/imgArrows"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="双向箭头"
        android:src="@drawable/double_arrows"
        app:layout_constraintBottom_toBottomOf="@id/boxDca"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/boxDca" />

    <!-- One Way 橙色【窄框】 -->
    <TextView
        android:id="@+id/boxOneWay"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:background="#EF6C00"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="56dp"
        android:text="One Way"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/boxDca" />

    <!-- 开关：叠在 One Way 框右端 -->
    <Switch
        android:id="@+id/switchOneWay"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="4dp"
        android:background="#EF6C00"
        app:layout_constraintBottom_toBottomOf="@id/boxOneWay"
        app:layout_constraintEnd_toEndOf="@id/boxOneWay"
        app:layout_constraintTop_toTopOf="@id/boxOneWay" />

    <!-- 1 Traveller 橙色窄框 -->
    <TextView
        android:id="@+id/boxTraveller"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:background="#EF6C00"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="1 Traveller"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/boxOneWay" />

    <!-- 星系大图 -->
    <ImageView
        android:id="@+id/imgGalaxy"
        android:layout_width="124dp"
        android:layout_height="118dp"
        android:layout_marginTop="56dp"
        android:contentDescription="星系图片"
        android:src="@drawable/galaxy"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/boxTraveller" />

    <!-- 小火箭 -->

    <!-- 底部 DEPART 按钮 -->
    <ImageView
        android:id="@+id/imgRocket"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="44dp"
        android:layout_marginEnd="28dp"
        android:contentDescription="火箭"
        android:src="@drawable/rocket_icon"
        app:layout_constraintEnd_toStartOf="@id/imgGalaxy"
        app:layout_constraintTop_toTopOf="@id/imgGalaxy" />

    <Button
        android:id="@+id/btnDepart"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="#2E7D32"
        android:text="DEPART"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
