<?xml version="1.0" encoding="utf-8"?>
<!-- 实验一（线性布局）定义单元格的背景 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 填充色 -->
    <solid android:color="#000000" />

    <!-- 边框 -->
    <stroke
        android:width="1dp"
        android:color="#9E9E9E" />

    <!-- 四个角的圆角半径 -->
    <corners android:radius="0dp" />

</shape>
